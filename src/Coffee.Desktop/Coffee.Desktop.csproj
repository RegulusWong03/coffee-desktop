<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CoffeeDesktop</AssemblyName>
    <RootNamespace>CoffeeDesktop</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>coffee.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\assets\spritesheet.png" Link="assets\spritesheet.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="coffee.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
