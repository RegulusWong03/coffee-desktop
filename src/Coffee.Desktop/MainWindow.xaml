<Window x:Class="CoffeeDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="咖啡" Width="192" Height="208" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True">
  <Grid x:Name="PetSurface" Background="Transparent" MouseLeftButtonDown="Pet_MouseLeftButtonDown" MouseLeftButtonUp="Pet_MouseLeftButtonUp"
        MouseRightButtonUp="Pet_MouseRightButtonUp" MouseMove="Pet_MouseMove">
    <Image x:Name="PetImage" Stretch="Fill" SnapsToDevicePixels="True" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="NearestNeighbor" />
  </Grid>
</Window>
